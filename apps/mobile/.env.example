# Copy to apps/mobile/.env (gitignored). Use the CornerIQ project only —
# not Luju POS / auto. See docs/SUPABASE.md.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy fallback:
# SUPABASE_ANON_KEY=eyJ...

# Google Sign-In (native). Web client ID is required as serverClientId.
# Create OAuth clients in Google Cloud Console — see docs/SUPABASE.md.
GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# iOS only (optional on Android):
# GOOGLE_IOS_CLIENT_ID=123456789-yyyy.apps.googleusercontent.com

# Optional: family watch public page base (must end with /watch/ or similar).
# Default: Azure partner deck static site /watch/
# WATCH_SHARE_BASE_URL=https://riderlabdeck.z21.web.core.windows.net/watch/

# RevenueCat (optional). When set, Pro uses store entitlements (`pro`).
# Leave empty for sideload / local Settings toggle.
# REVENUECAT_API_KEY=appl_or_goog_public_sdk_key
