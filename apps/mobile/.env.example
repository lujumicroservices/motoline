# Copy to apps/mobile/.env (gitignored). Use the RiderLab Supabase project only —
# not Luju POS / auto. See docs/SUPABASE.md.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy fallback:
# SUPABASE_ANON_KEY=eyJ...

# Google Sign-In (native). Web client ID is required as serverClientId.
# Create OAuth clients in Google Cloud Console — see docs/SUPABASE.md.
GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Required on iOS (Google Cloud → iOS OAuth client for com.rawthrottle.riderlab):
GOOGLE_IOS_CLIENT_ID=123456789-yyyy.apps.googleusercontent.com

# Optional: family watch public page base (must end with /watch/ or similar).
# Default: https://riderlab.rawthrottle.com.mx/watch/
# WATCH_SHARE_BASE_URL=https://riderlab.rawthrottle.com.mx/watch/

# RevenueCat (optional). When set, Pro uses store entitlements (`pro`).
# Leave empty for sideload / local Settings toggle.
# REVENUECAT_API_KEY=appl_or_goog_public_sdk_key

# Azure Function that mints a 15-minute write SAS for IMU replay blobs.
# Storage lives in rg-riderlab (not rg-nkmoto). Never put the account key here.
AZURE_LEAN_SAS_URL=https://riderlabimusas.azurewebsites.net/api/lean-replay-sas

# Road routing uses the valhalla-route Edge Function (Valhalla / Stadia Maps).
# Place search uses the places-search Edge Function (Google Places).
# Do not put VALHALLA_* or GOOGLE_PLACES_API_KEY here — they are function secrets.
